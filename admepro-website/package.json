{
  "name": "admepro-website",
  "version": "0.1.0",
  "private": true,
  "description": "admepro.com rebuilt as a fast static site (English + Arabic). Test phase, separate from SocialFlow.",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node build/build.mjs",
    "build:staging": "SITE_ENV=staging SITE_URL=https://new.admepro.com node build/build.mjs",
    "serve": "node build/serve.mjs",
    "preview": "node build/build.mjs && node build/serve.mjs",
    "new-project": "node build/new-project.mjs"
  }
}
